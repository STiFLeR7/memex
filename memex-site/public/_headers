# Cloudflare Workers static assets: response headers for every route.
# CSP is left out until it is tested against the inline theme script, the
# JSON-LD and Next's inline flight scripts.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Content-hashed build output never changes under the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
